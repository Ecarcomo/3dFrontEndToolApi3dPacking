# Base URL del microservicio 3dPacking (sin /api al final).
# Vite solo expone variables con prefijo VITE_ al código del cliente.
VITE_URL_API=http://localhost:5501

# Clave API (opcional). Solo en desarrollo o si VITE_URL_API apunta directo al backend.
# En Netlify sin VITE_URL_API, la clave va en el panel: PACKING_API_KEY (servidor, no VITE_).
# VITE_API_KEY=tu-clave-secreta

# --- Netlify (Site settings → Environment variables, no en .env del repo) ---
# PACKING_API_BASE=https://tu-api-real.com
# PACKING_API_KEY=opcional-misma-que-arriba-pero-solo-servidor
# No definas VITE_URL_API en el build de Netlify si quieres usar las functions como proxy.

# Límite de usos de "Calcular espacio" exitosos (opcional). Número entero > 0.
# Vacío = sin límite. El contador se guarda en localStorage del navegador.
# VITE_PACK_CALC_MAX_USES=10
